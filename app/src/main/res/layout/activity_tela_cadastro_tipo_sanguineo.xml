<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:fillViewport="true"
    tools:context=".TelaCadastroTipoSanguineo">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/textView3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Qual o seu tipo Sanguíneo?"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTipoSanguineo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#FFFFFFFF"
            app:cardCornerRadius="24dp"
            app:cardElevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textView3">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <RadioGroup
                    android:id="@+id/grupoTipoSanguineo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <RadioButton
                        android:id="@+id/Apositivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_radio_tipo_sanguineo"
                        android:button="@null"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingEnd="20dp"
                        android:text="A+"
                        android:textColor="@color/text_radio_tipo_sanguineo"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/Anegativo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_radio_tipo_sanguineo"
                        android:button="@null"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingEnd="20dp"
                        android:text="A-"
                        android:textColor="@color/text_radio_tipo_sanguineo"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/Bpositivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_radio_tipo_sanguineo"
                        android:button="@null"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingEnd="20dp"
                        android:text="B+"
                        android:textColor="@color/text_radio_tipo_sanguineo"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/Bnegativo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_radio_tipo_sanguineo"
                        android:button="@null"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingEnd="20dp"
                        android:text="B-"
                        android:textColor="@color/text_radio_tipo_sanguineo"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/ABpositivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_radio_tipo_sanguineo"
                        android:button="@null"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingEnd="20dp"
                        android:text="AB+"
                        android:textColor="@color/text_radio_tipo_sanguineo"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/ABnegativo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_radio_tipo_sanguineo"
                        android:button="@null"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingEnd="20dp"
                        android:text="AB-"
                        android:textColor="@color/text_radio_tipo_sanguineo"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/Opositivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_radio_tipo_sanguineo"
                        android:button="@null"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingEnd="20dp"
                        android:text="O+"
                        android:textColor="@color/text_radio_tipo_sanguineo"
                        android:textSize="17sp" />

                    <RadioButton
                        android:id="@+id/Onegativo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_radio_tipo_sanguineo"
                        android:button="@null"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center_vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingBottom="14dp"
                        android:paddingEnd="20dp"
                        android:text="O-"
                        android:textColor="@color/text_radio_tipo_sanguineo"
                        android:textSize="17sp" />

                </RadioGroup>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAvancarTipoSanguineo"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#558B2F"
                    android:text="Avançar"
                    android:textAllCaps="false"
                    android:textSize="18sp"
                    app:cornerRadius="16dp"
                    app:elevation="4dp"
                    app:layout_constraintTop_toBottomOf="@id/grupoTipoSanguineo"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>