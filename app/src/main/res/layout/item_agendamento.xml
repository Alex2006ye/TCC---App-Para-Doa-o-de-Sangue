<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardAgendamento"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    app:cardCornerRadius="50dp"
    app:cardBackgroundColor="#009900">

    <TextView
        android:id="@+id/txtNomeHemocentroAgendadoRecycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:text="Nome do Hemocentro Exemplo"
        android:textColor="@color/white"
        android:textSize="22sp"/>

    <TextView
        android:id="@+id/txtDiaHoraRecycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="55dp"
        android:layout_marginBottom="20dp"
        android:text="Dia e Hora de Exemplo"
        android:textColor="@color/white"/>

</androidx.cardview.widget.CardView>