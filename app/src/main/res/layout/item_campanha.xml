<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardCampanha"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="10dp"
    app:cardCornerRadius="50dp"
    app:cardBackgroundColor="#FF0000">

    <TextView
        android:id="@+id/txtNomeCampanhaRecycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:text="Nome Campanha Exemplo"
        android:textColor="@color/white"
        android:textSize="22sp"/>

    <TextView
        android:id="@+id/txtIdCampanhaRecycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="300dp"
        android:layout_marginTop="45dp"
        android:layout_marginBottom="20dp"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="20sp"/>

    <TextView
        android:id="@+id/txtTipoSanguineoRecycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="55dp"
        android:layout_marginBottom="20dp"
        android:text="Tipo Sanguineo Exemplo"
        android:textColor="@color/white"/>

    <TextView
        android:id="@+id/txtStatusRecycler"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="80dp"
        android:layout_marginBottom="20dp"
        android:text="Inativa"
        android:textColor="@color/white"/>

</androidx.cardview.widget.CardView>