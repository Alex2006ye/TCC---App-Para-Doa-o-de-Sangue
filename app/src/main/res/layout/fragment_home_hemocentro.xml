<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6FFFFFF"
    tools:context=".HomeHemocentroFragment"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="8dp"
        android:background="#9E9D24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D1CF50"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TÍTULO -->
            <TextView
                android:id="@+id/tituloCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Campanhas Ativas"
                android:textColor="#000"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- VALOR DINÂMICO -->
            <TextView
                android:id="@+id/numeroCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="0"
                android:textColor="#D32F2F"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="8dp"
        android:background="#9E9D24"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D1CF50"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tituloSegundoCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Campanhas Finalizadas"
                android:textColor="#000"
                android:textSize="16sp"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:id="@+id/numeroSegundoCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#D32F2F"
                android:textSize="28sp"
                android:textStyle="bold">
            </TextView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_margin="8dp"
        android:background="#9E9D24"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#D1CF50"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tituloTerceiroCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Agendamentos Ativos"
                android:textColor="#000"
                android:textSize="16sp"
                android:textStyle="bold">
            </TextView>

            <TextView
                android:id="@+id/numeroTerceiroCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#D32F2F"
                android:textSize="28sp"
                android:textStyle="bold">
            </TextView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</LinearLayout>