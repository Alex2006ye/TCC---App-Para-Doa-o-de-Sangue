<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".TelaTipoSanguineoAlterar">

    <TextView
        android:id="@+id/textView6"
        android:layout_width="396dp"
        android:layout_height="55dp"
        android:gravity="center"
        android:text="Alterar Tipo Sanguíneo Visado "
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.466"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.105" />

    <RadioGroup
        android:id="@+id/grupoTipoSanguineoVisadoAlterar"
        android:layout_width="350dp"
        android:layout_height="422dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.624">

        <RadioButton
            android:id="@+id/radioApositivoAlterar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A+" />

        <RadioButton
            android:id="@+id/radioAnegativoAlterar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A-" />

        <RadioButton
            android:id="@+id/radioBpositivoAlterar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="B+" />

        <RadioButton
            android:id="@+id/radioBnegativoAlterar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="B-" />

        <RadioButton
            android:id="@+id/radioABpositivoAlterar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AB+" />

        <RadioButton
            android:id="@+id/radioABnegativoAlterar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AB-" />

        <RadioButton
            android:id="@+id/radioOpositivoAlterar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O+" />

        <RadioButton
            android:id="@+id/radioOnegativoAlterar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="O-" />
    </RadioGroup>

    <Button
        android:id="@+id/btnAlteracaoCampanha"
        android:layout_width="181dp"
        android:layout_height="72dp"
        android:backgroundTint="#558B2F"
        android:text="Alterar"
        android:textColor="#FAF5F5"
        android:textColorLink="#C62828"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.976" />

</androidx.constraintlayout.widget.ConstraintLayout>