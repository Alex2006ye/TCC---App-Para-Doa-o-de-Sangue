<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".TelaCadastroDoadores">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="199dp"
        android:layout_height="216dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.452"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.031"
        app:srcCompat="@drawable/blood_donation_3347773" />

    <EditText
        android:id="@+id/edtNomeDoadorCadastro"
        android:layout_width="264dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Nome"
        android:inputType="text"
        android:textColorHint="#100C0C"
        tools:layout_editor_absoluteX="57dp"
        tools:layout_editor_absoluteY="257dp" />

    <EditText
        android:id="@+id/edtEmailDoadorCadastro"
        android:layout_width="266dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Email"
        android:inputType="text"
        android:textColorHint="#090606"
        tools:layout_editor_absoluteX="57dp"
        tools:layout_editor_absoluteY="324dp" />

    <EditText
        android:id="@+id/edtIdadeDoadorCadastro"
        android:layout_width="287dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Data de Nascimento"
        android:inputType="text"
        android:textColorHint="#0B0808"
        tools:layout_editor_absoluteX="57dp"
        tools:layout_editor_absoluteY="461dp" />

    <EditText
        android:id="@+id/edtSenhaDoadorCadastro"
        android:layout_width="274dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Senha"
        android:inputType="text"
        android:textColorHint="#141010"
        tools:layout_editor_absoluteX="57dp"
        tools:layout_editor_absoluteY="390dp" />

    <EditText
        android:id="@+id/editTextText5"
        android:layout_width="285dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Peso"
        android:inputType="text"
        android:textColorHint="#090505"
        tools:layout_editor_absoluteX="57dp"
        tools:layout_editor_absoluteY="535dp" />

    <Button
        android:id="@+id/btnAvancarCadastroDoador"
        android:layout_width="254dp"
        android:layout_height="71dp"
        android:backgroundTint="#558B2F"
        android:text="Avançar"
        android:textSize="20sp"
        app:cornerRadius="5dp"
        tools:layout_editor_absoluteX="78dp"
        tools:layout_editor_absoluteY="621dp" />

</androidx.constraintlayout.widget.ConstraintLayout>