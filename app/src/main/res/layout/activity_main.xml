<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="199dp"
        android:layout_height="216dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.034"
        app:srcCompat="@drawable/blood_donation_3347773" />

    <EditText
        android:id="@+id/edtEmail"
        android:layout_width="367dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="56dp"
        android:background="@android:drawable/edit_text"
        android:ems="10"
        android:hint="Email"
        android:inputType="text"
        android:textColor="#0B0505"
        android:textColorHint="#0D0A0A"
        app:layout_constraintBottom_toTopOf="@+id/edtSenhaLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView"
        app:layout_constraintVertical_bias="0.809" />

    <TextView
        android:id="@+id/txtLinkCadastro"
        android:layout_width="336dp"
        android:layout_height="38dp"
        android:layout_marginBottom="36dp"
        android:clickable="true"
        android:gravity="center"
        android:text="Não tem conta? Crie uma por aqui"
        android:textColor="#1565C0"
        android:textColorLink="#1565C0"
        android:textSize="20sp"
        app:layout_constraintBottom_toTopOf="@+id/btnEntrarLogin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnEntrarLogin"
        android:layout_width="223dp"
        android:layout_height="64dp"
        android:layout_marginBottom="96dp"
        android:backgroundTint="#2E7D32"
        android:text="Entrar"
        android:textSize="20sp"
        app:cornerRadius="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/edtSenhaLogin"
        android:layout_width="365dp"
        android:layout_height="46dp"
        android:layout_marginBottom="48dp"
        android:background="@android:drawable/edit_text"
        android:ems="10"
        android:hint="Senha"
        android:inputType="text|textPassword"
        android:textColor="#0B0909"
        android:textColorHint="#0D0B0B"
        app:layout_constraintBottom_toTopOf="@+id/txtLinkCadastro"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.529"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>